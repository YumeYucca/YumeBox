<?xml version="1.0" encoding="utf-8"?>
<!-- Throwaway host for the P0 spike: a real VpnService that hands its tun fd to the sing-box core
     in a child process. Nothing here is meant to ship; it exists so the fd handover and the
     platform.OpenTun path can be proven on a device before touching YumeBox itself. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.yumebox.spike">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="YumeBox Spike"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".CoreVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
