{
  "name": "yumebox-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply yumebox-analytics --local",
    "db:migrate:remote": "wrangler d1 migrations apply yumebox-analytics --remote",
    "build": "vp build --config vite.dashboard.config.ts && vp build",
    "deploy": "pnpm run build && wrangler deploy",
    "dev:dashboard": "vp dev --config vite.dashboard.config.ts",
    "dev:worker": "wrangler dev"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@mintlify/components": "1.0.16",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0"
}
